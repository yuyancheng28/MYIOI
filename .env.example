# API
PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
DATABASE_PATH=./data/vote.db
# For PostgreSQL, set DATABASE_URL and optionally DB_SSL=true
# DATABASE_URL=postgres://user:password@localhost:5432/vote
# DB_SSL=false
# Set both values to bootstrap the first superadmin (at least 8 password characters)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
# Optional allowed frontend origin, for example http://localhost:3000
# WEB_ORIGIN=http://localhost:3000

# Web (set in the frontend deployment environment)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
